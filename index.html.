<script>
function begin(){
 document.getElementById('beginning').scrollIntoView({behavior:'smooth'});
}

const scenes={
 1:{
  title:"The First Page",
  message:"13 May 2026. The beginning of a story neither of us had seen before. Six months later, this date has its own little place in our hearts."
 },
 2:{
  title:"The Little Things",
  message:"Getting to know someone is a collection of little discoveries. Their habits, their voice, their expressions and all the details that slowly become familiar."
 },
 3:{
  title:"Our Own Language",
  message:"The conversations, the silly jokes, the random moments and all those little things that only the two of us understand."
 },
 4:{
  title:"The Unscripted Parts",
  message:"Not every scene is easy. Real relationships take patience, honesty, communication and the willingness to understand each other."
 },
 5:{
  title:"Between the Scenes",
  message:"Some of the most meaningful moments aren't dramatic. They're the ordinary days, the little conversations and the effort we make for one another."
 },
 6:{
  title:"The Next Chapter",
  message:"Six months have passed. This isn't a final goodbye or an ending. It's a little celebration of everything we've experienced and everything we can still learn together."
 }
};

function openScene(n){
 const s=scenes[n];
 document.getElementById('sceneNumber').innerText='SCENE 00'+n;
 document.getElementById('sceneTitle').innerText=s.title;
 document.getElementById('sceneMessage').innerText=s.message;
 document.getElementById('scenePopup').classList.add('show');
}
function closeScene(){
 document.getElementById('scenePopup').classList.remove('show');
}
function answer(message){
 document.getElementById('answer').innerText=message;
}
function revealLetter(){
 const l=document.getElementById('letter');
 l.classList.add('show','reveal');
}
document.addEventListener('keydown',e=>{
 if(e.key==='Escape')closeScene();
});

// Floating cinematic particles
for(let i=0;i<16;i++){
 const heart=document.createElement('div');
 heart.className='floating';
 heart.innerText='♥';
 heart.style.left=Math.random()*100+'vw';
 heart.style.animationDelay=(Math.random()*9)+'s';
 heart.style.animationDuration=(7+Math.random()*8)+'s';
 heart.style.fontSize=(10+Math.random()*15)+'px';
 document.body.appendChild(heart);
}
</script>

