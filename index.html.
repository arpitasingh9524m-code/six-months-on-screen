}
.card h3{font-size:35px;color:var(--pink);margin:10px}
.card p{font-size:12px}
.chapter-list{
 max-width:700px;width:100%;display:grid;
 gap:12px;margin-top:40px;
}
.chapter{
 display:flex;align-items:center;text-align:left;
 gap:20px;width:100%;padding:20px;
 color:var(--white);background:#120e10;
 border:1px solid #39262d;transition:.3s;
}
.chapter:hover{border-color:var(--red);background:#28131a}
.chapter .num{font-family:'Cormorant Garamond';font-size:40px;color:var(--red)}
.chapter .details{flex:1}
.chapter h3{font-size:24px;font-weight:400}
.chapter p{font-size:9px;letter-spacing:2px}
.chapter .arrow{color:var(--pink)}
.popup{
 display:none;position:fixed;inset:0;z-index:40;
 background:#000e;align-items:center;justify-content:center;
 padding:20px;
}
.popup.show{display:flex}
.popup-inner{
 max-width:570px;width:100%;background:#1b1015;
 border:1px solid #9d5263;padding:40px 25px;
}
.popup-inner h2{color:var(--pink);margin:20px 0}
.close{background:none;border:0;color:var(--pink);margin-top:30px;letter-spacing:3px}
.grid{
 display:grid;grid-template-columns:repeat(2,1fr);
 max-width:750px;width:100%;gap:14px;margin-top:35px;
}
.reason{
 padding:25px 15px;background:#150e12;
 border:1px solid #402630;
}
.reason h3{color:var(--pink);font-size:25px;margin-bottom:10px}
.reason p{font-size:12px}
.counter{
 font-family:'Cormorant Garamond';font-size:100px;
 color:var(--pink);margin:20px;
}
.question{
 max-width:550px;width:100%;padding:35px;
 border:1px solid #613440;background:#150e12;margin-top:30px;
}
.question h3{font-size:35px;margin-bottom:20px}
.answer{color:var(--pink);margin-top:20px;min-height:30px}
.letter{
 max-width:650px;width:100%;padding:40px 30px;
 background:#160f12;border:1px solid #6c3b47;margin-top:30px;
}
.letter p{
 font-family:'Cormorant Garamond',serif;
 font-size:22px;color:var(--white);margin:15px 0;
}
.hidden{display:none}
.hidden.show{display:block}
.final{
 background:radial-gradient(ellipse at center,#571c2a,#180b10 45%,#080708 80%);
}
.final h1{margin:35px 0;color:var(--pink)}
.final .last{
 font-family:'Cormorant Garamond';font-size:29px;
 font-style:italic;color:var(--white);margin:25px 0;
}
footer{text-align:center;padding:25px;color:#78666c;font-size:10px;letter-spacing:3px}
.floating{
 position:fixed;bottom:-30px;color:#a64d60;
 pointer-events:none;animation:float 9s linear infinite;
 opacity:.35;z-index:0;
}
@keyframes float{
 to{transform:translateY(-110vh) rotate(40deg);opacity:0}
}
.reveal{
 animation:reveal 1s ease both;
}
@keyframes reveal{
 from{opacity:0;transform:translateY(25px)}
 to{opacity:1;transform:translateY(0)}
}
@media(max-width:550px){
 .grid{grid-template-columns:1fr}
 section{padding:90px 20px}
 .card,.letter{padding:25px 18px}
 .chapter{gap:12px;padding:14px}
}
</style>
</head>

