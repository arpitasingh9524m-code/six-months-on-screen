.hero .date{margin-top:35px;color:var(--pink)}
.nav{
 position:fixed;top:0;left:0;width:100%;z-index:20;
 padding:18px 7%;display:flex;justify-content:space-between;
 background:#080708df;backdrop-filter:blur(12px);
 border-bottom:1px solid #ffffff12;
